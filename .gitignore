# KNIME workspace internals (logs, browser cache, UI state)
workflow/.metadata/

# KNIME runtime / execution data inside workflows
**/.knimeLock   
**/port_*/
**/internal/
**/internalTables/
**/filestore/

# Local config with secrets / machine paths
workflow/config.json

# SQLite database (built by the workflows) + WAL files
workflow/data/*.db
workflow/data/*.db-wal
workflow/data/*.db-shm

# Option snapshot archive (written by scripts/archive_db.py, Parquet, ~5 MB per day)
workflow/data/archive/

# Python virtual environment for scripts/
scripts/.venv/

# .NET build output
scheduler/bin/
scheduler/obj/

# Local scheduler notes
scheduler/RUNBOOK.md

.DS_Store
